<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>TradeSimulator.Testing</RootNamespace>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
        <PackageReference Include="Testcontainers.PostgreSql" Version="4.13.0" />
        <PackageReference Include="Testcontainers.RabbitMq" Version="4.13.0" />
        <PackageReference Include="Testcontainers.Redis" Version="4.13.0" />
        <!-- Overrides the vulnerable SSH.NET pulled in transitively by Testcontainers (GHSA-mggc-4xg6-vcxf) -->
        <PackageReference Include="SSH.NET" Version="2026.0.0" />
        <PackageReference Include="Npgsql" Version="10.0.3" />
        <PackageReference Include="RabbitMQ.Client" Version="7.1.2" />
        <PackageReference Include="xunit" Version="2.9.3" />
    </ItemGroup>

</Project>
